<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  The App Sandbox is deliberately OFF for now: reading NSPasteboard's source app and
	  synthesising Cmd+V both need capabilities the sandbox does not grant. Distribution
	  is therefore Developer ID + notarisation, not the Mac App Store. See
	  docs/adr/0003-distribution-and-sandboxing.md.
	-->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<!-- Only used by link enrichment, which the user can turn off entirely. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
</dict>
</plist>
