<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>Recall Two-Factor Helper</string>
	<key>CFBundleExecutable</key>
	<string>com.recall.otp</string>
	<key>CFBundleIdentifier</key>
	<string>com.recall.otp</string>
	<key>CFBundlePackageType</key>
	<string>XPC!</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<!--
	  An XPCService bundled inside the app is launched by launchd only on behalf of that
	  app, which is the first half of the containment. The second half is the code-signing
	  requirement both ends check.
	-->
	<key>XPCService</key>
	<dict>
		<key>ServiceType</key>
		<string>Application</string>
		<key>RunLoopType</key>
		<string>NSRunLoop</string>
	</dict>
</dict>
</plist>
