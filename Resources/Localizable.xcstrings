    "How much of what is behind shows through the panel, the scratchpad and the pinned items. Turn it off for a plain background — easier to read against a busy desktop." : {
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "چه مقدار از پس‌زمینه از میان پنل، چرک‌نویس و موارد سنجاق‌شده دیده شود. برای پس‌زمینهٔ ساده خاموشش کنید — روی میزکار شلوغ خواناتر است."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Насколько фон просвечивает сквозь панель, черновик и закреплённые элементы. Выключите для простого фона — его легче читать на пёстром рабочем столе."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "面板、草稿板和已固定项的背景透出程度。关闭后使用纯色背景——在杂乱的桌面上更易阅读。"
          }
        }
      }
    },
