    "2FA codes, card numbers and API keys are detected as they are copied and removed automatically — unless you pin them." : {
      "localizations" : {
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کدهای تأیید دومرحله‌ای، شماره‌های کارت و کلیدهای API هنگام کپی شناسایی و به‌طور خودکار حذف می‌شوند — مگر اینکه آن‌ها را سنجاق کنید."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коды 2FA, номера карт и ключи API распознаются при копировании и удаляются автоматически, если вы их не закрепите."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
